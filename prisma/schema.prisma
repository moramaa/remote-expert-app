// Prisma schema for FieldSync MVP
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Machines (seed data, shared by cert picker + SOS flow) ──────────────────

model Machine {
  id     String @id   // e.g. "krones_filler"
  label  String       // e.g. "Krones Filler"
  vendor String       // e.g. "Krones"

  certifications ExpertCertification[]
  playbooks      Playbook[]
}

// ── Session outcomes (persisted after every matched call) ───────────────────

model Session {
  id              String    @id @default(uuid())
  ticketId        String    @unique
  expertId        String
  workerId        String
  machineId       String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  resolvedExpert  Boolean?  // true = Yes; false = No (expert's answer)
  resolvedWorker  Boolean?  // true = Yes; false = No (worker's answer)
  summary         String?   // brief human-readable description of the resolved issue
}

// ── Deflection analytics (Smart SOS Deflection flow) ───────────────────────

model DeflectionEvent {
  id                 String   @id @default(uuid())
  workerId           String
  machineId          String
  suggestedSessionId String?  // which past session was shown as suggestion
  outcome            String   // "solved" | "unsolved"
  createdAt          DateTime @default(now())
}

// ── Playbooks (pre-defined step-by-step resolution scripts) ────────────────

model Playbook {
  id        String  @id @default(uuid())
  machineId String
  name      String
  steps     String  // JSON-encoded string[]

  machine Machine @relation(fields: [machineId], references: [id])
}

// ── Expert profile ──────────────────────────────────────────────────────────

model Expert {
  id              String @id   // UUID from client localStorage
  name            String
  yearsExperience Int
  languages       String       // JSON-encoded string[], e.g. '["en","de"]'
  createdAt       DateTime @default(now())

  certifications ExpertCertification[]
}

model ExpertCertification {
  expertId  String
  machineId String

  expert  Expert  @relation(fields: [expertId],  references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id])

  @@id([expertId, machineId])
}

// ── Worker profile ──────────────────────────────────────────────────────────

model Worker {
  id        String @id   // UUID from client localStorage
  name      String
  factory   String
  roleLevel String       // "junior_operator" | "maintenance" | "senior_operator"
  createdAt DateTime @default(now())
}
